# Copy to .env and fill in. Every VITE_ variable ships in the browser bundle.
# NEVER put the service_role key, database password, or any server-only secret here.

# Supabase project (Dashboard > Settings > API). The anon/publishable key is safe to
# expose; the real protection is row-level security (see supabase/migrations/).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
